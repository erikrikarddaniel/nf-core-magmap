/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    --mag_outdir needs a local directory, so the test downloads the nf-core/mag output
    from test-datasets first, see tests/mag_outdir.nf.test.

    Use as follows:
        nextflow run nf-core/magmap -profile test_mag_outdir,<docker/singularity> --mag_outdir <MAG_OUTDIR> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test mag_outdir profile'
    config_profile_description = 'Test dataset to check genomes and metadata from an nf-core/mag output directory, together with --genomeinfo'

    // Input data
    input      = params.pipelines_testdata_base_path + 'magmap/samplesheets/samplesheet.csv'
    genomeinfo = params.pipelines_testdata_base_path + 'magmap/testdata/genometest.csv'
}
