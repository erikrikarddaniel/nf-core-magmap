nextflow_function {

    name "Test scanMagOutdir, validateUniqueAccnos and the GTDB quality filter"
    script "../main.nf"
    tag "subworkflows"
    tag "utils_nfcore_magmap_pipeline"

    test("scanMagOutdir: dereplicated bins, one Prokka GFF, GTDB-Tk and CheckM2") {

        function "scanMagOutdir"

        when {
            function {
                """
                def root = file('mag_full')
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins").mkdirs()
                file("\${root}/GenomeBinning/QC").mkdirs()
                file("\${root}/Taxonomy/GTDB-Tk").mkdirs()
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/SPAdes-MaxBin2-s1.002.fa.gz").text = 'x'
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/MEGAHIT-MaxBin2-s1.001.fa.gz").text = 'x'
                file("\${root}/GenomeBinning/QC/checkm2_summary.tsv").text = 'x'
                file("\${root}/Taxonomy/GTDB-Tk/gtdbtk_summary.tsv").text = 'x'
                file("\${root}/Annotation/Prokka/external/SPAdes-MaxBin2-s1.002").mkdirs()
                file("\${root}/Annotation/Prokka/external/SPAdes-MaxBin2-s1.002/SPAdes-MaxBin2-s1.002.gff").text = 'x'
                file("\${root}/Annotation/Prokka/external/SPAdes-MaxBin2-s1.002/SPAdes-MaxBin2-s1.002.gbk").text = 'x'
                input[0] = 'mag_full'
                input[1] = 'none'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.genomes*.accno == ['MEGAHIT-MaxBin2-s1.001', 'SPAdes-MaxBin2-s1.002'] },
                { assert function.result.genomes.collect { g -> g.genome_fna.toString().tokenize('/')[-1] } == ['MEGAHIT-MaxBin2-s1.001.fa.gz', 'SPAdes-MaxBin2-s1.002.fa.gz'] },
                { assert function.result.genomes[0].genome_gff == [] },
                { assert function.result.genomes[1].genome_gff.toString().endsWith('/Annotation/Prokka/external/SPAdes-MaxBin2-s1.002/SPAdes-MaxBin2-s1.002.gff') },
                { assert function.result.gtdbtk_metadata.size() == 1 && function.result.gtdbtk_metadata[0].endsWith('/mag_full/Taxonomy/GTDB-Tk/gtdbtk_summary.tsv') },
                { assert function.result.checkm_metadata.size() == 1 && function.result.checkm_metadata[0].endsWith('/mag_full/GenomeBinning/QC/checkm2_summary.tsv') }
            )
        }
    }

    test("scanMagOutdir: CheckM instead of CheckM2, no GTDB-Tk") {

        function "scanMagOutdir"

        when {
            function {
                """
                def root = file('mag_checkm')
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins").mkdirs()
                file("\${root}/GenomeBinning/QC").mkdirs()
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/bin_1.fa.gz").text = 'x'
                file("\${root}/GenomeBinning/QC/checkm_summary.tsv").text = 'x'
                input[0] = 'mag_checkm'
                input[1] = 'none'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.genomes*.accno == ['bin_1'] },
                { assert function.result.gtdbtk_metadata == [] },
                { assert function.result.checkm_metadata.size() == 1 && function.result.checkm_metadata[0].endsWith('/mag_checkm/GenomeBinning/QC/checkm_summary.tsv') }
            )
        }
    }

    test("scanMagOutdir: no dereplicated bins fails") {

        function "scanMagOutdir"

        when {
            function {
                """
                file('mag_nobins/GenomeBinning').mkdirs()
                input[0] = 'mag_nobins'
                input[1] = 'none'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { line -> line.contains('no dereplicated bins found') } || function.stderr.any { line -> line.contains('no dereplicated bins found') } }
            )
        }
    }

    test("scanMagOutdir: --mag_filter gtdb keeps passing bins, boundaries included") {

        function "scanMagOutdir"

        when {
            function {
                """
                def root = file('mag_filter')
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins").mkdirs()
                file("\${root}/GenomeBinning/QC").mkdirs()
                def rows = [ pass: [95, 1], score_boundary: [55, 1], low_score: [55, 2], contamination_boundary: [90, 5], low_completeness: [40, 0] ]
                rows.keySet().each { name -> file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/\${name}.fa.gz").text = 'x' }
                file("\${root}/GenomeBinning/QC/checkm2_summary.tsv").text = 'Name\tCompleteness\tContamination\\n' + rows.collect { name, v -> "\${name}\t\${v[0]}\t\${v[1]}" }.join('\\n') + '\\n'
                input[0] = 'mag_filter'
                input[1] = 'gtdb'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // contamination < 5 excludes 5.0 and completeness - 5 * contamination >= 50 includes 50.0
                { assert function.result.genomes*.accno == ['pass', 'score_boundary'] }
            )
        }
    }

    test("scanMagOutdir: --mag_filter none keeps every bin") {

        function "scanMagOutdir"

        when {
            function {
                """
                def root = file('mag_nofilter')
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins").mkdirs()
                file("\${root}/GenomeBinning/QC").mkdirs()
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/bad.fa.gz").text = 'x'
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/good.fa.gz").text = 'x'
                file("\${root}/GenomeBinning/QC/checkm2_summary.tsv").text = 'Name\tCompleteness\tContamination\\nbad\t10\t9\\ngood\t95\t1\\n'
                input[0] = 'mag_nofilter'
                input[1] = 'none'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.genomes*.accno == ['bad', 'good'] }
            )
        }
    }

    test("scanMagOutdir: --mag_filter gtdb without a CheckM2 summary fails") {

        function "scanMagOutdir"

        when {
            function {
                """
                def root = file('mag_filter_nocheckm2')
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins").mkdirs()
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/bin_1.fa.gz").text = 'x'
                input[0] = 'mag_filter_nocheckm2'
                input[1] = 'gtdb'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('needs the CheckM2 summary') } }
            )
        }
    }

    test("scanMagOutdir: --mag_filter gtdb with a bin missing from the CheckM2 summary fails") {

        function "scanMagOutdir"

        when {
            function {
                """
                def root = file('mag_filter_missing')
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins").mkdirs()
                file("\${root}/GenomeBinning/QC").mkdirs()
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/bin_1.fa.gz").text = 'x'
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/bin_2.fa.gz").text = 'x'
                file("\${root}/GenomeBinning/QC/checkm2_summary.tsv").text = 'Name\tCompleteness\tContamination\\nbin_1\t95\t1\\n'
                input[0] = 'mag_filter_missing'
                input[1] = 'gtdb'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('bins missing from') && line.contains('bin_2') } }
            )
        }
    }

    test("scanMagOutdir: --mag_filter gtdb that removes every bin fails") {

        function "scanMagOutdir"

        when {
            function {
                """
                def root = file('mag_filter_none_pass')
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins").mkdirs()
                file("\${root}/GenomeBinning/QC").mkdirs()
                file("\${root}/GenomeBinning/Dereplication/dereplicated_bins/bin_1.fa.gz").text = 'x'
                file("\${root}/GenomeBinning/QC/checkm2_summary.tsv").text = 'Name\tCompleteness\tContamination\\nbin_1\t50.5\t9.9\\n'
                input[0] = 'mag_filter_none_pass'
                input[1] = 'gtdb'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('pass GTDB') } }
            )
        }
    }

    test("validateUniqueAccnos: distinct accessions pass") {

        function "validateUniqueAccnos"

        when {
            function {
                """
                input[0] = [[accno: 'bin_1'], [accno: 'bin_2']]
                """
            }
        }

        then {
            assert function.success
        }
    }

    test("validateUniqueAccnos: accession in both sources fails") {

        function "validateUniqueAccnos"

        when {
            function {
                """
                input[0] = [[accno: 'bin_1'], [accno: 'bin_2'], [accno: 'bin_1']]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('Duplicated: bin_1') } }
            )
        }
    }
}
